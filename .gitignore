# .gitignore ----

# R history and workspace files
.Rhistory
.RData
.RDataTmp
.Ruserdata
.Renviron
.Rprofile.site

# RStudio files
.Rproj.user/

# Scratch & temporary testing files
scratch/
temp/
tmp/
*.log
*.tmp
*.bak

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Build and package artifacts
*.tar.gz
*.Rcheck/
